# Copy to /etc/minimodes/minimodes.env (mode 0600, owner minimodes) and fill in.
# Generate with: openssl rand -hex 32
GATE_VELOCITY_SECRET=change-me
MINIMODES_VELOCITY_SECRET=change-me
# Postgres over the local socket (database and role `minimodes`).
MINIMODES_DATABASE_URL=postgres:///minimodes?host=/run/postgresql
